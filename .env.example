# Environment variables for ErrorSnap
# Copy this file to .env and fill in real values

# Neon PostgreSQL connection string
# Format: postgres://user:password@host/dbname
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/errorsnap

# OpenRouter API key for LLM generation
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter model identifier (optional)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional: required only when submitting screenshots. Choose a vision-capable
# OpenRouter model, for example a supported GPT-4o, Gemini, or Llama Vision model.
OPENROUTER_VISION_MODEL=

# Per-instance protection for the public solve endpoint (requests per minute).
RATE_LIMIT_MAX_REQUESTS=20
